{
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "expectedSessionVersion": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "PROPOSE",
        "REVIEW"
      ]
    },
    "lookId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "required": [
    "sessionId",
    "expectedSessionVersion",
    "mode",
    "lookId"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "REVIEW"
          }
        }
      },
      "then": {
        "properties": {
          "lookId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "else": {
        "properties": {
          "lookId": {
            "type": "null"
          }
        }
      }
    }
  ]
}
