# Foundation runs without external credentials. Never commit real .env files.
APP_MODE=FOUNDATION
DEMO_MODE=true
PAYMENT_MODE=DEMO
WAREHOUSE_MODE=DEMO
LIVE_PROVIDERS_ENABLED=false
DATABASE_URL=postgresql+psycopg://anchor:local-only@127.0.0.1:5432/anchor_fit
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=anchor-fit-private
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
YOUCAM_BASE_URL=
YOUCAM_API_KEY=
STYLIST_PROVIDER=gemini
STYLIST_MODEL=gemini-3.8-flash
STYLIST_API_KEY=
AUTH_EMAIL_HOST=
AUTH_EMAIL_PORT=587
AUTH_EMAIL_USERNAME=
AUTH_EMAIL_PASSWORD=
AUTH_EMAIL_FROM=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# No API keys, storage credentials or auth secrets may use NEXT_PUBLIC_.
